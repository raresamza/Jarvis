#!/usr/bin/env bash
set -Eeuo pipefail

PLANNER_MODEL="${JARVIS_PLANNER_MODEL:-qwen3.6:35b}"
EXECUTOR_AGENT="${JARVIS_EXECUTOR_AGENT:-website-builder}"
OLLAMA_URL="${OLLAMA_URL:-http://127.0.0.1:11434}"

TEN_HOURS_MS="36000000"
TEN_HOURS_SECONDS="36000"

if [[ $# -eq 0 ]]; then
  echo 'Usage: jarvis-code "Describe the coding task"'
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: jq is required. Install it with:"
  echo "sudo apt install -y jq"
  exit 1
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "Error: Claude Code is not installed or is not in PATH."
  exit 1
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: run jarvis-code from inside a Git repository."
  exit 1
fi

REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
TASK="$*"
RUN_ID="$(date +%Y%m%d-%H%M%S)"
RUN_DIR="$HOME/.local/share/jarvis/runs/$RUN_ID"

PLANNING_RESPONSE="$RUN_DIR/planning-response.json"
THINKING_FILE="$RUN_DIR/thinking.md"
PLAN_FILE="$RUN_DIR/plan.md"
EXECUTION_PROMPT_FILE="$RUN_DIR/execution-prompt.md"
EXECUTION_LOG="$RUN_DIR/execution.log"
DEBUG_LOG="$RUN_DIR/claude-debug.log"

mkdir -p "$RUN_DIR"

echo
echo "Repository:"
echo "$REPOSITORY_ROOT"
echo
echo "Stage 1 of 2: Qwen is reasoning and preparing the plan..."
echo

jq -n \
  --arg model "$PLANNER_MODEL" \
  --arg task "$TASK" \
  --arg repository "$REPOSITORY_ROOT" \
  '{
    model: $model,
    stream: false,
    think: true,
    keep_alive: "30m",
    options: {
      temperature: 0.2
    },
    messages: [
      {
        role: "system",
        content: (
          "You are the planning component of an autonomous software engineering system. " +
          "Think carefully before producing the final plan. " +
          "You do not have tools and must not pretend to inspect or modify files. " +
          "Prepare a concrete plan that another coding agent can execute. " +
          "Include architecture, files to inspect, files likely to change, implementation order, " +
          "validation steps, risks, accessibility, responsiveness, and completion criteria. " +
          "Keep the final plan practical and directly executable."
        )
      },
      {
        role: "user",
        content: (
          "Repository path: " + $repository + "\n\n" +
          "Task:\n" + $task
        )
      }
    ]
  }' |
curl \
  --silent \
  --show-error \
  --fail \
  --max-time "$TEN_HOURS_SECONDS" \
  "$OLLAMA_URL/api/chat" \
  -H "Content-Type: application/json" \
  --data-binary @- > "$PLANNING_RESPONSE"

jq -r '.message.thinking // empty' \
  "$PLANNING_RESPONSE" > "$THINKING_FILE"

jq -r '.message.content // empty' \
  "$PLANNING_RESPONSE" > "$PLAN_FILE"

if [[ ! -s "$PLAN_FILE" ]]; then
  echo "Error: Qwen returned no final implementation plan."
  echo "Raw response:"
  echo "$PLANNING_RESPONSE"
  exit 1
fi

echo "Implementation plan:"
echo
echo "------------------------------------------------------------"
cat "$PLAN_FILE"
echo "------------------------------------------------------------"
echo

cat > "$EXECUTION_PROMPT_FILE" <<EOF
Implement the requested task in the current repository.

# Original task

$TASK

# Implementation plan

$(cat "$PLAN_FILE")

# Mandatory execution requirements

- Inspect the repository before modifying files.
- Treat the plan as guidance, not as proof of the current repository state.
- Adapt the plan when the actual repository requires it.
- Create and modify the necessary files using Claude Code tools.
- Work incrementally and inspect the results of important edits.
- Do not merely print code in the final response.
- Run appropriate validation commands.
- Correct failures caused by your changes.
- Do not read .env files, credentials, SSH keys, or files outside this repository.
- Do not deploy, publish, push, or force-push.
- At completion, report:
  1. files created or changed
  2. features implemented
  3. validation commands executed
  4. validation results
  5. remaining limitations
EOF

echo "Stage 2 of 2: Claude Code with GLM is implementing the plan..."
echo

cd "$REPOSITORY_ROOT"

API_TIMEOUT_MS="$TEN_HOURS_MS" \
CLAUDE_STREAM_IDLE_TIMEOUT_MS="$TEN_HOURS_MS" \
BASH_DEFAULT_TIMEOUT_MS="$TEN_HOURS_MS" \
BASH_MAX_TIMEOUT_MS="$TEN_HOURS_MS" \
CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS="$TEN_HOURS_MS" \
CLAUDE_CODE_MAX_RETRIES="1" \
CLAUDE_CODE_DISABLE_THINKING="1" \
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1" \
claude \
  --agent "$EXECUTOR_AGENT" \
  --debug-file "$DEBUG_LOG" \
  -p "$(cat "$EXECUTION_PROMPT_FILE")" \
  2>&1 | tee "$EXECUTION_LOG"

echo
echo "Task execution finished."
echo
echo "Repository status:"
git status --short || true

echo
echo "Run files:"
echo "  Reasoning trace: $THINKING_FILE"
echo "  Final plan:      $PLAN_FILE"
echo "  Execution prompt:$EXECUTION_PROMPT_FILE"
echo "  Execution log:   $EXECUTION_LOG"
echo "  Claude debug:    $DEBUG_LOG"
